{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 8am on monday"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 8am on monday"
    ],
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "automerge": true,
    "labels": [
      "security"
    ]
  },
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 6,
  "packageRules": [
    {
      "description": "Non-major Cargo updates together: one PR, one CI run (#195).",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "cargo non-major"
    },
    {
      "description": "Non-major npm updates of the SDKs together (#195).",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm non-major"
    },
    {
      "description": "GitHub Actions digests and versions together (#195).",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "The SLSA generator's reusable workflows verify the ref they are called at: keep them on a release tag, never a digest (#473).",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "slsa-framework/slsa-github-generator"
      ],
      "pinDigests": false
    },
    {
      "description": "DataFusion, Arrow and Parquet move together: one PR, one CI run.",
      "groupName": "datafusion and arrow",
      "matchPackageNames": [
        "/^datafusion/",
        "/^arrow/",
        "parquet",
        "object_store"
      ]
    },
    {
      "description": "Everything non-major merges itself once the gate is green (auto-merge.yml).",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Before 1.0, a 0.x minor of a crate is a major: review it like one. Kept out of the auto-merging Cargo group, so that group still merges itself.",
      "matchManagers": [
        "cargo"
      ],
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ],
      "groupName": "cargo 0.x minors"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ]
    }
  ]
}
